PORT=5000
NODE_ENV=development

# JWT authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real secret. Auth endpoints fail safely when this is missing.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MongoDB connection string (database name: fit_track)
#   Local MongoDB: mongodb://127.0.0.1:27017/fit_track
#   MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fit_track
# Leave empty to run the API without a database — /api/health still works.
MONGO_URI=

# Allowed frontend origin(s) for CORS (comma-separated for multiple)
CLIENT_URL=http://localhost:5173
